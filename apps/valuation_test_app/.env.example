# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# J-Quants API（Phase 2で使用）
# 以下の優先順位で認証される:
#   1. JQUANTS_API_KEY が設定されていればそれを使用（推奨）
#   2. JQUANTS_REFRESH_TOKEN が設定されていればそれを使用
#   3. メール・パスワードで認証（2段階認証が有効な場合は失敗することがある）
JQUANTS_API_KEY=your_jquants_api_key_here
JQUANTS_MAIL_ADDRESS=your_email@example.com
JQUANTS_PASSWORD=your_password_here
JQUANTS_REFRESH_TOKEN=

# EDINET API（Phase 2で使用）
EDINET_API_KEY=your_edinet_api_key_here
